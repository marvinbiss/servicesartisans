    {
      "path": "/api/cron/cee-dossier-transitions",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/noindex-sweep",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/google-algo-monitor",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/lighthouse-budget",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/cron/canonical-fingerprint",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/cee-relance",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/export-rge-dataset",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/cron/pipedrive-dead-letter-review",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/claim-auto-approve",
      "schedule": "0 * * * *"
    }
  ]
}
