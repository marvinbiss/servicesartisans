{
  "framework": "nextjs",
  "regions": ["cdg1"],
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=8192"
    }
  },
  "functions": {
    "src/app/**/*.tsx": {
      "maxDuration": 30
    },
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/rge-sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/lighthouse-budget/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/sitemap-providers/route.ts": {
      "maxDuration": 90
    },
    "src/app/api/vapi/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/healthcheck",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/send-reminders-1h",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/send-review-invitations",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/calculate-trust-badges",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/process-gdpr-deletions",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/purge-rgpd",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/lead-reassign",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/prospection-process",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/recalculate-quality",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/sitemap-health",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/check-aides-freshness",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/redis-health",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/indexnow-submit",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/voice-lead-expiry",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/voice-stats",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/gsc-index-stats",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/googlebot-analysis",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/pruning-audit",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/cron/cache-warmup",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/check-radiees",
      "schedule": "0 5 * * 0"
    },
    {
      "path": "/api/cron/gsc-sync",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/metrics-snapshot",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/link-scores",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/orphan-check",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/pipedrive-retry",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/api/cron/simulateur-pipedrive-retry",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/rgpd-anonymize",
