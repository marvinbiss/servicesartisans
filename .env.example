# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-postgres-db-password

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PREMIUM_PRICE_ID=price_...

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email notifications (Resend)
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@servicesartisans.fr

# Resend Webhook Secret (from Resend dashboard -> Webhooks)
RESEND_WEBHOOK_SECRET=whsec_...

# Unsubscribe token signing secret
UNSUBSCRIBE_SECRET=your-random-unsubscribe-secret

# Prospection opt-out HMAC secret (article L.34-5 CPCE)
# Utilisé par /api/prospection/optout pour signer les liens de désinscription
# one-click. Min 16 chars aléatoires. OBLIGATOIRE en production.
PROSPECTION_OPTOUT_SECRET=your-random-optout-secret-min-16-chars

# Sel dédié au hash SHA-256 des IPs opt-out (preuve CNIL minimisée).
# DOIT être distinct de PROSPECTION_OPTOUT_SECRET : un leak du HMAC ne doit
# pas compromettre la réversibilité des IPs stockées (et inversement).
# OBLIGATOIRE en production (fail-close). En dev, si absent, ip_hash = null.
PROSPECTION_IP_HASH_SALT="change-me-32-bytes-random"

# Google Calendar Integration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cron Jobs Security
CRON_SECRET=your-random-cron-secret

# Internal server-to-server API secret
# Utilisé par /api/cee/dispatch (wrapping HTTP du dispatcher CEE) pour
# authentifier les appels serveur-à-serveur depuis le tunnel devis.
# Min 32 chars aléatoires. OBLIGATOIRE en production (fail-closed).
INTERNAL_API_SECRET=change-me-server-to-server-cee-dispatch

# CEE — IBAN encryption key (pgcrypto.pgp_sym_encrypt côté SQL)
# Min 32 bytes random base64. OBLIGATOIRE en production (fail-close).
# Utilisé par src/lib/cee/iban-crypto.ts pour chiffrer les IBAN
# dans cee_artisan_partners.iban_encrypted.
CEE_IBAN_KEY=change-me-32-bytes-base64-random-for-pgcrypto

# Yousign (signature électronique convention mandataire CEE + mandats client)
# API v3: https://developers.yousign.com/reference
YOUSIGN_API_KEY=your-yousign-api-key
YOUSIGN_WEBHOOK_SECRET=your-yousign-webhook-secret

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# INSEE SIRENE API (for importing artisans)
# Get credentials at: https://api.insee.fr
INSEE_CONSUMER_KEY=
INSEE_CONSUMER_SECRET=

# Pappers API (for SIRET validation)
PAPPERS_API_KEY=

# IndexNow (instant search engine notification)
INDEXNOW_API_KEY=your-32-char-hex-key

# IndexNow webhook secret — HMAC-SHA256 for /api/webhooks/provider-seo-refresh
# Min 16 chars random. OBLIGATOIRE en production.
INDEXNOW_WEBHOOK_SECRET=your-random-indexnow-webhook-secret-min-16-chars

# ISR Revalidation Secret
REVALIDATE_SECRET=your-revalidation-secret

# Voice Qualification (Vapi + ElevenLabs)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=

# Pipedrive CRM
# Token + domain are shared by 3 integrations:
#   - /api/devis                    → pipeline PIPEDRIVE_PIPELINE_ID (source="servicesartisans.fr")
#   - /api/simulateur/submit        → pipeline PIPEDRIVE_PIPELINE_SIMULATEUR (source="simulateur-aides")
#   - /api/simulateur/callback      → pipeline PIPEDRIVE_PIPELINE_SIMULATEUR (source="callback-simulateur")
# Leave token/domain blank to disable all three.
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=
# Devis pipeline
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_STAGE_ID=
# Simulateur aides pipeline (dedicated, shared by submit + callback)
PIPEDRIVE_PIPELINE_SIMULATEUR=
PIPEDRIVE_STAGE_SIMULATEUR=
# Optional custom field keys (shared across the 3 integrations when configured)
PIPEDRIVE_FIELD_SERVICE=
PIPEDRIVE_FIELD_URGENCY=
PIPEDRIVE_FIELD_CITY=
PIPEDRIVE_FIELD_POSTAL_CODE=
PIPEDRIVE_FIELD_SOURCE=
# Simulateur aides — traçabilité plan 20/20 (optionnels)
PIPEDRIVE_FIELD_BAREME_VERSION=
PIPEDRIVE_FIELD_REQUEST_ID=
PIPEDRIVE_FIELD_MONTANT_TOTAL=

# -----------------------------------------------------------------------------
# Identité société — LCEN art.6 (mentions légales, sanction 75 000€ + 1 an)
# -----------------------------------------------------------------------------
# Tant que la SAS n'est pas immatriculée, laisser COMPANY_STATUS=pre-launch
# (ou ne rien set : default = pre-launch). Pour publier en mode "launched",
# il faut explicitement set COMPANY_STATUS=launched ET les 4 vars légales.
# Sinon `npm run build` échoue (deploy bloqué avant la prod).
COMPANY_STATUS=pre-launch
COMPANY_SIRET=
COMPANY_LEGAL_NAME=
COMPANY_FORME_JURIDIQUE=
COMPANY_CAPITAL_SOCIAL=
COMPANY_RCS=
COMPANY_TVA=
COMPANY_ADDRESS=
COMPANY_DIRECTEUR_PUBLICATION=
COMPANY_FOUNDING_DATE=
# COMPANY_PHONE par défaut "07 56 87 27 87" si non set.
COMPANY_PHONE=

# -----------------------------------------------------------------------------
# Rate-limit distribué — Upstash Redis (incident GSC fail-close 2026-04-22)
# -----------------------------------------------------------------------------
# Sans ces 2 vars, le rate-limit retombe sur MemoryRateLimiter (par instance,
# pas distribué). Le code reste fail-OPEN sur les routes user-facing critiques
# (cf. src/lib/rate-limiter.ts) mais la protection anti-bursts est dégradée.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Observabilité — Sentry (erreurs + APM + session replay)
# -----------------------------------------------------------------------------
# DSN : copie depuis sentry.io → Settings → Projects → servicesartisans → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Org/Project slugs (pour l'upload des source maps depuis Vercel CI)
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token pour source maps : sentry.io → Settings → Auth Tokens → "project:releases"
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Observabilité — PostHog (product analytics + funnels + session replay)
# -----------------------------------------------------------------------------
# Project API Key : eu.posthog.com → Project settings → Project variables
NEXT_PUBLIC_POSTHOG_KEY=
# Cloud EU (par défaut). Pour Cloud US mettre https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# -----------------------------------------------------------------------------
# Observabilité — BetterStack Heartbeats (dead-man switches for critical crons)
# -----------------------------------------------------------------------------
BETTERSTACK_HEARTBEAT_PIPEDRIVE_RETRY=
BETTERSTACK_HEARTBEAT_SITEMAP_HEALTH=
BETTERSTACK_HEARTBEAT_INDEXNOW_SUBMIT=
BETTERSTACK_HEARTBEAT_RGE_SYNC=
