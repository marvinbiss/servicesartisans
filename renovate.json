{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":enableVulnerabilityAlertsWithLabel(security)",
    ":dependencyDashboard",
    "schedule:weekends",
    "group:monorepos",
    "group:recommended",
    "group:linters",
    "group:test"
  ],

  "description": [
    "ServicesArtisans — politique mises à jour dépendances 2026-05-02.",
    "Objectif : zéro CVE oubliée + groupage des bumps mineurs pour réduire la charge review.",
    "Activation : connecter renovate-bot à github.com/<owner>/servicesartisans via app GitHub Marketplace."
  ],

  "labels": ["dependencies", "renovate"],
  "rangeStrategy": "bump",
  "timezone": "Europe/Paris",
  "prHourlyLimit": 4,
  "prConcurrentLimit": 8,
  "rebaseWhen": "behind-base-branch",
  "platformAutomerge": true,
  "configMigration": true,

  "vulnerabilityAlerts": {
    "labels": ["security", "vulnerability"],
    "schedule": "at any time",
    "automerge": false,
    "minimumReleaseAge": "0 days",
    "prPriority": 10
  },

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"],
    "automerge": false,
    "commitMessageAction": "Refresh lockfile"
  },

  "packageRules": [
    {
      "description": "Next.js — jamais d'auto-merge, breaking changes fréquents (ex: 14→15 SSR API)",
      "matchPackageNames": [
        "next",
        "@next/bundle-analyzer",
        "@next/eslint-plugin-next",
        "eslint-config-next"
      ],
      "groupName": "Next.js",
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "labels": ["dependencies", "next.js", "needs-manual-review"]
    },

    {
      "description": "Supabase — jamais d'auto-merge, schema/auth changes possibles",
      "matchPackageNames": [
        "@supabase/supabase-js",
        "@supabase/ssr",
        "@supabase/auth-helpers-nextjs"
      ],
      "groupName": "Supabase",
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "labels": ["dependencies", "supabase", "needs-manual-review"]
    },

    {
      "description": "Sentry — auto-merge patch uniquement (instrumentation peut breaker)",
      "matchPackageNames": ["@sentry/nextjs", "@sentry/cli", "@sentry/profiling-node"],
      "groupName": "Sentry",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "matchPackageNames": ["@sentry/nextjs", "@sentry/cli", "@sentry/profiling-node"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "labels": ["dependencies", "sentry", "needs-manual-review"]
    },

    {
      "description": "Capacitor (mobile) — major bumps cassent l'iOS/Android build",
      "matchPackageNames": ["@capacitor/*"],
      "groupName": "Capacitor",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "minimumReleaseAge": "14 days",
      "labels": ["dependencies", "capacitor", "needs-manual-review"]
    },

    {
      "description": "Stripe — financier, jamais auto-merge",
      "matchPackageNames": ["@stripe/*", "stripe"],
      "groupName": "Stripe",
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "labels": ["dependencies", "stripe", "needs-manual-review", "financial"]
    },

    {
      "description": "Anthropic SDK — review semaine, breaking changes possibles entre minors",
      "matchPackageNames": ["@anthropic-ai/sdk"],
      "groupName": "Anthropic SDK",
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "labels": ["dependencies", "anthropic", "needs-manual-review"]
    },

    {
      "description": "TypeScript / @types/* — auto-merge minor+patch après 3j",
      "matchPackageNames": ["typescript", "@types/*"],
      "groupName": "TypeScript",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },

    {
      "description": "ESLint / Prettier — auto-merge non-major après 3j",
      "matchPackageNames": ["eslint", "prettier", "/^eslint-/", "@typescript-eslint/*"],
      "groupName": "Linting",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },

    {
      "description": "Vitest / Playwright — auto-merge non-major après 3j",
      "matchPackageNames": [
        "vitest",
        "@vitest/*",
        "@playwright/test",
        "playwright",
        "playwright-core"
      ],
      "groupName": "Test runners",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },

    {
      "description": "Tailwind / PostCSS — auto-merge patch (themes/build), review minor+major",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/*", "postcss", "autoprefixer"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "matchPackageNames": ["tailwindcss", "@tailwindcss/*"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "labels": ["dependencies", "tailwind", "needs-manual-review"]
    },

    {
      "description": "Tiptap — version coupling stricte entre extensions, regrouper",
      "matchPackageNames": ["@tiptap/*"],
      "groupName": "Tiptap",
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "labels": ["dependencies", "tiptap"]
    },

    {
      "description": "Pin majors uniquement — pas de bump major sans review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-bump", "needs-manual-review"],
      "minimumReleaseAge": "14 days"
    },

    {
      "description": "GitHub Actions — auto-merge minor+patch (sécurité actions/checkout etc.)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    }
  ],

  "ignoreDeps": [],

  "osvVulnerabilityAlerts": true,

  "postUpdateOptions": ["npmDedupe"]
}
