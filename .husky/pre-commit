#!/usr/bin/env sh
# Pre-commit hook — sécurité + audits parallèles + lint staged.
#
# Architecture (2026-05-05 fix dette technique #1) :
#   1. Fast-fail security : gitleaks scan staged secrets
#   2. Migration uniqueness : pas de double numéro
#   3. Audits anti-régression PARALLÈLES : la liste source-de-vérité est
#      `.husky/audits.list` (un audit par ligne). L'orchestrateur
#      `scripts/run-audits-parallel.mjs` lit ce fichier et spawn tous les
#      audits en parallèle. Speedup mesuré 5.2x (18.4s → 3.6s sur 71 audits).
#   4. Loop kill-switch : sentinelle ahrefs gaps + bloat + drift.
#      DOIT rester séquentiel après les audits (lit plan-coverage).
#   5. lint-staged : ESLint + Prettier sur les fichiers stagés.
#
# Pour ajouter/désactiver un audit : éditer `.husky/audits.list` (pas ce fichier).

set -e

sh scripts/gitleaks-precommit.sh
node scripts/check-migration-unique.mjs
node scripts/run-audits-parallel.mjs --strict
node scripts/loop-kill-switch.mjs --strict
npx lint-staged
