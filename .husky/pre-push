#!/usr/bin/env sh
# Pre-push hook — anti-drift code↔DB et migrations repo↔prod.
#
# Run AFTER pre-commit (qui audite déjà 30+ checks statiques). Pre-push est
# le bon tradeoff pour les checks réseau : on accepte 20-30s de probe Supabase
# REST UNE FOIS au push, plutôt qu'à chaque commit local.
#
# 2 audits indépendants :
#   1. audit-schema-drift.mjs   — code TS/SQL .select() vs colonnes prod
#                                 (baseline `.schema-drift-baseline.json`)
#   2. audit-migrations-applied.mjs — fichiers `supabase/migrations/*.sql`
#                                     vs table `supabase_migrations.schema_migrations`
#                                     (détecte les "j'ai oublié de pousser"
#                                      qui ont causé 4 incidents en 1 mois :
#                                      mig 475/477/483/486)
#
# Skippable via SKIP_SCHEMA_DRIFT=1 git push (pour cas force-push urgent).

if [ "$SKIP_SCHEMA_DRIFT" = "1" ]; then
  echo "⚠️  schema-drift audits SKIPPED (SKIP_SCHEMA_DRIFT=1)"
  exit 0
fi

# Windows-only quirk : Node sur Windows déclenche parfois une assertion libuv
# `UV_HANDLE_CLOSING` au cleanup du processus (rc=127 ou rc=134) alors que la
# logique du script s'est bien terminée (exit 0 explicite). Pour ne pas bloquer
# les push légitimes, on traite tout rc >= 100 comme un succès libuv-glitch.
# Les vrais audit failures retournent rc=1 (strict mode), bien sous le seuil.
run_audit() {
  node "$@"
  rc=$?
  if [ $rc -ge 100 ]; then
    echo "⚠️  Node exit $rc (libuv quirk Windows) — audit logic OK, on continue."
    return 0
  fi
  return $rc
}

run_audit scripts/audit-schema-drift.mjs --baseline-check --strict || exit 1
run_audit scripts/audit-migrations-applied.mjs --strict || exit 1
