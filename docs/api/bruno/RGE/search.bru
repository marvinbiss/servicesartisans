meta {
  name: RGE Search
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/rge/search?city=paris&qualification=QualiPAC
  body: none
  auth: none
}

params:query {
  city: paris
  qualification: QualiPAC
  limit: 20
  offset: 0
}

headers {
  Accept: application/json
}

docs {
  Search RGE providers by city + qualification code.
  Returns max 50 active providers, ORDER BY rge_valid_until DESC.
}
